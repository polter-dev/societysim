{
  "datasets": [
    {
      "name": "win_rates",
      "displayName": "Win rate by model and role",
      "queryLines": [
        "SELECT model, grp AS role, games, wins, win_rate\n",
        "FROM workspace.societysim.metrics_win_rates\n",
        "WHERE model <> '*' AND grp <> 'all'"
      ]
    },
    {
      "name": "lies",
      "displayName": "Lies and lie success",
      "queryLines": [
        "SELECT model, source, lies, lie_rate, share_moved, share_followed, base_rate\n",
        "FROM workspace.societysim.metrics_lies\n",
        "WHERE grp = 'all' AND model <> '*'"
      ]
    },
    {
      "name": "detection",
      "displayName": "Detection (village seats)",
      "queryLines": [
        "SELECT model, n, brier, auc\n",
        "FROM workspace.societysim.metrics_detection\n",
        "WHERE grp = 'village' AND model <> '*'"
      ]
    },
    {
      "name": "persuasion",
      "displayName": "Persuasion",
      "queryLines": [
        "SELECT model, accusations, voters, hits, share\n",
        "FROM workspace.societysim.metrics_persuasion\n",
        "WHERE grp = 'all' AND model <> '*'"
      ]
    },
    {
      "name": "games_over_time",
      "displayName": "Games over time",
      "queryLines": [
        "SELECT date_trunc('HOUR', to_timestamp(started_at)) AS hour, winner, count(*) AS games\n",
        "FROM workspace.societysim.games\n",
        "GROUP BY ALL"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "intro",
            "multilineTextboxSpec": {
              "lines": [
                "# societysim: LLM Werewolf\n",
                "Per-model metrics from the T3.3 port in `metrics.py`, over every ingested game. Lie success and persuasion are exploratory: correlation, not cause."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "win_rate_by_role",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "win_rates",
                  "fields": [
                    {
                      "name": "model",
                      "expression": "`model`"
                    },
                    {
                      "name": "win_rate",
                      "expression": "`win_rate`"
                    },
                    {
                      "name": "role",
                      "expression": "`role`"
                    }
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "model",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Model"
                },
                "y": {
                  "fieldName": "win_rate",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Win rate",
                  "format": {
                    "type": "number-percent"
                  }
                },
                "color": {
                  "fieldName": "role",
                  "scale": {
                    "type": "categorical"
                  },
                  "displayName": "Role"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Win rate by model and role"
              },
              "mark": {
                "layout": "group"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 6,
            "height": 7
          }
        },
